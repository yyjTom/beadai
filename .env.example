# Public canonical URL. Used for OAuth callbacks, magic links and sitemap.
NEXT_PUBLIC_SITE_URL=https://beadai.app

# Support address shown in the UI and transactional emails.
SUPPORT_EMAIL=support@beadai.app

# PostgreSQL connection string (Neon, Supabase Postgres or Vercel Postgres).
DATABASE_URL=

# Session signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Google OAuth (server-only). Authorized redirect URI must match exactly:
# https://beadai.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend transactional email. Use a verified sending domain with SPF, DKIM and DMARC.
RESEND_API_KEY=
EMAIL_FROM=beadai <no-reply@beadai.app>
MAGIC_LINK_TTL_MINUTES=15

# Together AI image generation.
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free
TOGETHER_TIMEOUT_MS=45000
TOGETHER_MAX_OUTPUT_BYTES=6291456
AI_ROUTE_MAX_DURATION_SECONDS=60

# Upstash Redis (quota, locks, rate limits).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GUEST_DAILY_AI_LIMIT=3

# Dodo Payments. Preview deployments must stay in test mode.
DODO_PAYMENTS_ENV=test
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRO_MONTHLY_PRODUCT_ID=
DODO_PRO_YEARLY_PRODUCT_ID=

# Amazon Associates. Required before real shopping links are shown.
AMAZON_ASSOCIATES_TAG=
AFFILIATE_BASE_URL=https://www.amazon.com/s?k={code}
